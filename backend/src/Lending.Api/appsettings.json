{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"Postgres": "Host=localhost;Port=5432;Database=lending;Username=acadmin;Password=acadmin"  
    "Postgres": "Host=localhost;Port=5433;Database=lending;Username=lending;Password=lending"
  },
  "ExternalService": {
    "BaseUrl": "http://localhost:4000"
  },
  "Rules": {
    "BlacklistedSsns": [ "111-11-1111", "666-66-6666" ]
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "MaxAttempts": 5,
    "BatchSize": 20,
    "BaseRetryDelay": "00:00:05"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
